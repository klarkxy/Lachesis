{
  "name": "@lachesis/domain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Persistent Lachesis domain service backed by Node 24 node:sqlite",
  "engines": {
    "node": ">=24.16.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types --test-concurrency=1 --test-reporter spec ./test/*.test.ts"
  },
  "dependencies": {
    "@lachesis/contracts": "workspace:*"
  }
}
