{
  "name": "@lachesis/workspace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Lachesis isolated run workspaces, immutable delivery artifacts, git three-way integration, and explicit local apply",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types --test-concurrency=1 --test-reporter spec ./test/*.test.ts"
  },
  "dependencies": {
    "@lachesis/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  }
}
