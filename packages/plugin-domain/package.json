{
  "name": "@lachesis/plugin-domain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cordis plugin exposing the persistent Lachesis domain service backed by Node 24 node:sqlite",
  "engines": {
    "node": ">=24.16.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types --test-concurrency=1 --test-reporter spec ./test/*.test.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@lachesis/contracts": "workspace:*"
  }
}
