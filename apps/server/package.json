{
  "name": "@lachesis/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Lachesis browser service: session pairing, the JSON API, and the SPA fallback over the plugin-provided operations",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@lachesis/contracts": "workspace:*",
    "@lachesis/plugin-domain": "workspace:*",
    "@lachesis/plugin-mcp": "workspace:*",
    "@lachesis/plugin-runtime-dsh": "workspace:*",
    "@lachesis/plugin-scheduler": "workspace:*",
    "@lachesis/plugin-workspace": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.0"
  }
}
